# =============================================================
# ManagmentServer — облачный сервер (Spring Boot, порт 8080)
# Скопируйте этот файл в .env и заполните реальными значениями
# =============================================================

# --- Server ---
SERVER_PORT=8080

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/vaultdb
DB_USERNAME=vaultuser
DB_PASSWORD=changeme

# --- JWT ---
# Минимум 256 бит (32 символа). Обязательно для production.
JWT_SECRET=change-me-to-a-random-256-bit-secret-key
JWT_EXPIRATION=86400000

# --- SMTP (Gmail) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
# App Password из Google Account → Security → 2-Step Verification → App Passwords
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# --- Application ---
APP_NAME=Password Manager

# --- VirusTotal ---
# Получить на https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_API_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_POLLING_INTERVAL=30000

# --- MinIO / S3 Backup ---
BACKUP_S3_ENABLED=false
BACKUP_S3_ENDPOINT=http://127.0.0.1:9000
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=vault-backups
BACKUP_S3_CRON=0 0 3 * * *
BACKUP_S3_RETENTION_DAYS=30
BACKUP_S3_REGION=us-east-1

# --- JPA / Debug ---
JPA_SHOW_SQL=false
