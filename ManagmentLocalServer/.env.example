# =================================================================
# ManagmentLocalServer — локальный сервер (Spring Boot, порт 3001)
# Скопируйте этот файл в .env и заполните реальными значениями
# =================================================================

# --- Server ---
SERVER_PORT=3001

# --- SQLite ---
DB_URL=jdbc:sqlite:./data/local_database.db

# --- JWT ---
# Должен совпадать с JWT_SECRET в ManagmentLocalServer (не с облачным сервером).
# Минимум 256 бит (32 символа).
JWT_SECRET=change-me-to-a-random-256-bit-secret-key
JWT_EXPIRATION=3600000

# --- Remote server ---
REMOTE_SERVER_URL=http://localhost:8080
REMOTE_SYNC_ENABLED=true
REMOTE_TIMEOUT=30000

# --- Device Security (AV policy) ---
SECURITY_DEVICE_ENFORCE=true
SECURITY_DEVICE_REQUIRE_REALTIME=true
SECURITY_DEVICE_REQUIRE_UP_TO_DATE=false
SECURITY_DEVICE_MAX_SNAPSHOT_AGE=120
# true — разрешить заглушку (не-Windows); false — строго требовать AV
SECURITY_DEVICE_ALLOW_STUB=true

# --- JPA / Debug ---
JPA_SHOW_SQL=false
